{
  "name": "llm-intro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nx run llm-intro-slides:dev",
    "build": "nx run @llm-intro/api-contract:build && nx run llm-intro-slides:build",
    "preview": "nx run llm-intro-slides:preview",
    "server": "nx run @llm-intro/api-contract:build && nx run llm-intro-slides:server",
    "lint": "nx run-many -t lint && pnpm run lint:boundaries",
    "lint:oxlint": "nx run-many -t lint",
    "lint:boundaries": "eslint \"apps/**/*.{ts,tsx,js,jsx}\" \"libs/**/*.{ts,tsx,js,jsx}\" --no-warn-ignored",
    "format": "oxfmt --write \"apps/**/*.{ts,tsx,js,jsx}\" \"libs/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "oxfmt --check \"apps/**/*.{ts,tsx,js,jsx}\" \"libs/**/*.{ts,tsx,js,jsx}\"",
    "test": "nx run @llm-intro/api-contract:build && nx run llm-intro-slides:test",
    "test:ui": "nx run llm-intro-slides:test:ui",
    "test:e2e": "nx run @llm-intro/api-contract:build && nx run llm-intro-slides:test:e2e",
    "typecheck": "nx run @llm-intro/api-contract:typecheck && nx run llm-intro-slides:typecheck",
    "proxy": "uvx --from 'headroom-ai[proxy,code]' headroom proxy --port ${HEADROOM_PORT:-8787}",
    "claude:proxy": "ANTHROPIC_BASE_URL=${HEADROOM_PROXY:-http://localhost:8787} claude",
    "codex:proxy": "OPENAI_BASE_URL=${HEADROOM_PROXY:-http://localhost:8787} codex",
    "archon:install": "node scripts/install-archon.mjs",
    "setup:worktree": "node scripts/setup-worktree.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@agent-native/core": "0.58.2",
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/openai": "^3.0.53",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@llm-intro/api-contract": "workspace:*",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.168",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.9.4",
    "nanoid": "^5.1.7",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.2.0",
    "vite-plugin-singlefile": "^2.3.2",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^22.7.5",
    "@nx/js": "^22.7.5",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.0.7",
    "nx": "^22.7.5",
    "oxfmt": "0.55.0",
    "oxlint": "^1.70.0",
    "portless": "^0.10.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.2.2",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3",
      "node-pty"
    ],
    "overrides": {
      "react-router": "7.18.0",
      "react-router-dom": "7.18.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "oxfmt --write"
  }
}
